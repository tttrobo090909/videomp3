<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- 1. 최상단 헤더 (상태바): [영상MP3 by 피피] & 우측 요약 상태창 [완료/추출중/녹음중] [N곡] (녹색 #81C784 원복) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[영상MP3 by 피피]"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[완료] [0곡]"
            android:textColor="@color/secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. 추출부 상단 3dp 회색 구분바 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider_gray" />

    <!-- 3. 추출 조작 영역: [♤/♠ 녹음] / [📁 파일] / [🔗 링크 입력창] / [⚡ 추출] (4개 컨트롤 42dp 높이 100% 완전 일치) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- [♤ / ♠ 녹음 버튼] -->
        <TextView
            android:id="@+id/btnRecord"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_spade_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="♤"
            android:textColor="#888888"
            android:textSize="20sp" />

        <!-- [📁 파일] 버튼 (기준 높이 42dp 칼일치 플랫 버튼) -->
        <TextView
            android:id="@+id/btnFile"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_flat_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="📁 파일"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- [🔗 링크 붙여넣기 버튼 + 입력창 + ✕] 박스 -->
        <LinearLayout
            android:id="@+id/layoutYoutubeInputBox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/btnLinkPaste"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="🔗"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etYoutubeUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="유튜브 링크 입력 (youtu.be/...)"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_secondary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnClearUrl"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/on_surface_secondary" />
        </LinearLayout>

        <!-- [⚡ 추출] 버튼 (기준 높이 42dp 칼일치 플랫 버튼) -->
        <TextView
            android:id="@+id/btnStartExtract"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_flat_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="⚡ 추출"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. 추출부 하단 3dp 회색 구분바 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider_gray" />

    <!-- 5. 전용 플레이어 영역 (곡 제목 마퀴, 탐색바, 좌측 모드 3버튼, 우측 제어 5버튼) -->
    <LinearLayout
        android:id="@+id/layoutPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- 플레이어 곡 제목 (보라색 음표 🎵 삭제) -->
        <TextView
            android:id="@+id/tvPlayerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:freezesText="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="재생할 곡을 목록에서 선택하세요"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 진행바(SeekBar) + 재생시간 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/sbPlayerProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:max="100"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="0"
                android:progressTint="@color/highlight_sky_blue"
                android:thumbTint="@color/highlight_sky_blue" />

            <TextView
                android:id="@+id/tvPlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00 / 00:00"
                android:textColor="@color/on_surface_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 플레이어 컨트롤 버튼들 (좌측 70% 축소 28dp, 우측 확대 44dp, 100% 화이트 벡터 아이콘, 활성화 시 하늘색 점등) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- [좌측 모드 버튼 그룹: 순수 단색 벡터 아이콘, 70% 축소 28dp] -->
            <!-- 🔂 1곡반복 (순환 화살표 + 1 아이콘) -->
            <ImageButton
                android:id="@+id/btnModeRepeatOne"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:padding="3dp"
                android:src="@drawable/ic_repeat_one"
                android:tint="#FFFFFF" />

            <!-- 🔁 전체반복 (순환 화살표 아이콘) -->
            <ImageButton
                android:id="@+id/btnModeRepeatAll"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:padding="3dp"
                android:src="@drawable/ic_repeat"
                android:tint="#FFFFFF" />

            <!-- 🔀 랜덤재생 (셔플 교차 화살표 아이콘) -->
            <ImageButton
                android:id="@+id/btnModeShuffle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:padding="3dp"
                android:src="@drawable/ic_shuffle"
                android:tint="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- [우측 재생 조작계 그룹: 이전 / 5초되감기 / ▶⏹전환 / 5초빨리감기 / 다음] (40~44dp 시원하게 확대, 100% 화이트 벡터) -->
            <!-- ⏮ 이전곡 -->
            <ImageButton
                android:id="@+id/btnPlayerPrevTrack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:src="@drawable/ic_skip_previous"
                android:tint="#FFFFFF" />

            <!-- ⏪5s (5초 되감기 순수 화이트 벡터) -->
            <ImageButton
                android:id="@+id/btnPlayerRewind5"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:src="@drawable/ic_fast_rewind"
                android:tint="#FFFFFF" />

            <!-- ▶ / ⏹ 재생·정지 상호 전환 단일 버튼 (순수 화이트 벡터 아이콘) -->
            <ImageButton
                android:id="@+id/btnPlayerPlayStop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:src="@drawable/ic_play_arrow"
                android:tint="#FFFFFF" />

            <!-- 5s⏩ (5초 빨리감기 순수 화이트 벡터) -->
            <ImageButton
                android:id="@+id/btnPlayerForward5"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:src="@drawable/ic_fast_forward"
                android:tint="#FFFFFF" />

            <!-- ⏭ 다음곡 -->
            <ImageButton
                android:id="@+id/btnPlayerNextTrack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:src="@drawable/ic_skip_next"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. 플레이어 하단 3dp 회색 구분바 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider_gray" />

    <!-- 7. 하단 목록 일반 헤더 (높이 36dp 고정으로 선택 모드 전환 시 리스트 밀림 원천 차단) -->
    <LinearLayout
        android:id="@+id/layoutNormalHeader"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📂 내 추출 음악 (Music/영상MP3)"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- [선택] 다중 선택 모드 진입 버튼 (회색) -->
        <TextView
            android:id="@+id/btnEnterSelectMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="선택"
            android:textColor="@color/on_surface_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 7-1. 하단 목록 선택 모드 헤더 (높이 36dp 고정으로 리스트 밀림 0%) -->
    <LinearLayout
        android:id="@+id/layoutSelectionHeader"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/cbSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/secondary"
            android:scaleX="0.85"
            android:scaleY="0.85"
            android:text="전체선택"
            android:textColor="@color/on_surface"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0개"
            android:textColor="@color/highlight_sky_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 삭제 버튼 (빨간색, 텍스트 화이트 선명) -->
        <Button
            android:id="@+id/btnDeleteSelected"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:backgroundTint="@color/delete_red"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="삭제"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 재생목록 추가 버튼 (하늘색 계열, 텍스트 화이트 선명) -->
        <Button
            android:id="@+id/btnAddToPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/highlight_sky_blue"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="재생목록 추가"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 취소 버튼 -->
        <TextView
            android:id="@+id/btnCancelSelection"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="취소"
            android:textColor="@color/on_surface_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 8. 당겨서 새로고침(SwipeRefreshLayout) + 한 줄 리스트 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMp3List"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Music/영상MP3 폴더에 추출된 곡이 없습니다.\n상단에서 유튜브 링크나 영상 파일을 추출해 보세요! 🎵"
                android:textColor="@color/on_surface_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
