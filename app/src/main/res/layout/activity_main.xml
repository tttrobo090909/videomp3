<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- 1. 최상단 헤더: [영상MP3 by 피피] & 우측 요약 상태창 [완료/추출중/녹음중] [N곡] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[영상MP3 by 피피]"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[완료] [0곡]"
            android:textColor="@color/secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. 상단 작업영역 상단 회색 구분바 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#333333" />

    <!-- 3. 추출 조작 영역: [♤/♠ 녹음] / [📁 파일] / [🔗 링크 입력창] / [⚡ 추출 시작] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- [♤ / ♠ 녹음 버튼] (대기: ♤ 짙은 회색 / 녹음중: ♠ 흰색) -->
        <TextView
            android:id="@+id/btnRecord"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_spade_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="♤"
            android:textColor="#888888"
            android:textSize="20sp" />

        <!-- [📁 파일] 버튼 -->
        <Button
            android:id="@+id/btnFile"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="@color/surface_variant"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="📁 파일"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- [🔗 링크 붙여넣기 버튼 + 입력창 + ✕] 박스 -->
        <LinearLayout
            android:id="@+id/layoutYoutubeInputBox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- 누르면 클립보드 내용이 바로 붙여넣어지는 🔗 버튼 -->
            <TextView
                android:id="@+id/btnLinkPaste"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="🔗"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etYoutubeUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="유튜브 링크 입력 (youtu.be/...)"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_secondary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnClearUrl"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/on_surface_secondary" />
        </LinearLayout>

        <!-- [⚡ 추출 시작] 버튼 -->
        <Button
            android:id="@+id/btnStartExtract"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="@color/primary"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="⚡ 추출 시작"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. 상단 작업영역 하단 회색 구분바 (상단 구분바와 동일 사이즈) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#333333" />

    <!-- 5. 하단 목록 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📂 내 추출 음악 (Music/영상MP3)"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 70% 크기로 축소된 새로고침 버튼 (18dp) -->
        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="@color/on_surface_secondary" />
    </LinearLayout>

    <!-- 6. 추출된 MP3 한 줄 리스트 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMp3List"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Music/영상MP3 폴더에 추출된 곡이 없습니다.\n상단에서 유튜브 링크나 영상 파일을 추출해 보세요! 🎵"
            android:textColor="@color/on_surface_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
