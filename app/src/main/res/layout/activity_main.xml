<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- 1. 최상단 헤더: [영상MP3 by 피피] & 우측 [완료/추출중] [N곡] 상태 표시 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[영상MP3 by 피피]"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[완료] [0곡]"
            android:textColor="@color/secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 초슬림 진행상태 프로그레스 바 -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/secondary"
        android:visibility="gone" />

    <!-- 2. 상단 3개 버튼 배열: [📁 파일] / [🔗 유튜브 링크 (+입력창)] / [⚡ 추출 시작] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- [📁 파일] 버튼 -->
        <Button
            android:id="@+id/btnFile"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="@color/surface_variant"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="📁 파일"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- [🔗 유튜브 링크] 입력창 박스 -->
        <LinearLayout
            android:id="@+id/layoutYoutubeInputBox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="🔗"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etYoutubeUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="유튜브 링크 입력 (youtu.be/...)"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_secondary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnPasteUrl"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="@color/on_surface_secondary" />

            <ImageButton
                android:id="@+id/btnClearUrl"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/on_surface_secondary" />
        </LinearLayout>

        <!-- [⚡ 추출 시작] 버튼 -->
        <Button
            android:id="@+id/btnStartExtract"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="@color/primary"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="⚡ 추출 시작"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 선택된 파일 또는 작업 진행 안내 서브 텍스트 -->
    <TextView
        android:id="@+id/tvSubStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 3. 하단 목록 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📂 내 추출 음악 (Music/영상MP3)"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="@color/on_surface_secondary" />
    </LinearLayout>

    <!-- 4. 추출된 MP3 한 줄 리스트 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMp3List"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Music/영상MP3 폴더에 추출된 곡이 없습니다.\n상단에서 유튜브 링크나 영상 파일을 추출해 보세요! 🎵"
            android:textColor="@color/on_surface_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
