<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- 1. 최상단 헤더 (상태바): [영상MP3 by 피피] & 우측 요약 상태창 [완료/추출중/녹음중] [N곡] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[영상MP3 by 피피]"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[완료] [0곡]"
            android:textColor="@color/secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. 추출부 상단 3dp 회색 구분바 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider_gray" />

    <!-- 3. 추출 조작 영역: [♤/♠ 녹음] / [📁 파일] / [🔗 링크 입력창] / [⚡ 추출] (높이 42dp 일치) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- [♤ / ♠ 녹음 버튼] -->
        <TextView
            android:id="@+id/btnRecord"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_spade_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="♤"
            android:textColor="#888888"
            android:textSize="20sp" />

        <!-- [📁 파일] 버튼 -->
        <Button
            android:id="@+id/btnFile"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="@color/surface_variant"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="📁 파일"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- [🔗 링크 붙여넣기 버튼 + 입력창 + ✕] 박스 -->
        <LinearLayout
            android:id="@+id/layoutYoutubeInputBox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/btnLinkPaste"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="🔗"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etYoutubeUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="유튜브 링크 입력 (youtu.be/...)"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_secondary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnClearUrl"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/on_surface_secondary" />
        </LinearLayout>

        <!-- [⚡ 추출] 버튼 -->
        <Button
            android:id="@+id/btnStartExtract"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:backgroundTint="@color/primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="⚡ 추출"
            android:textColor="@color/on_surface"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. 추출부 하단 3dp 회색 구분바 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider_gray" />

    <!-- 5. 전용 플레이어 영역 (곡 제목 마퀴, 탐색바, 5초 앞뒤/재생, 3대 반복/랜덤 모드) -->
    <LinearLayout
        android:id="@+id/layoutPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- 플레이어 곡 제목 -->
        <TextView
            android:id="@+id/tvPlayerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:freezesText="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="재생할 곡을 목록에서 선택하세요 🎵"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 진행바(SeekBar) + 재생시간 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/sbPlayerProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="0"
                android:progressTint="@color/secondary"
                android:thumbTint="@color/secondary" />

            <TextView
                android:id="@+id/tvPlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="00:00 / 00:00"
                android:textColor="@color/on_surface_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 플레이어 컨트롤 버튼들 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ⏪ 5초 -->
            <Button
                android:id="@+id/btnPlayerRewind5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:backgroundTint="@color/surface_variant"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="⏪ 5초"
                android:textColor="@color/on_surface"
                android:textSize="11sp" />

            <!-- ▶ / ⏸ 재생/일시정지 -->
            <Button
                android:id="@+id/btnPlayerPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="▶ 재생"
                android:textColor="@color/on_surface"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- ⏩ 5초 -->
            <Button
                android:id="@+id/btnPlayerForward5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/surface_variant"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="⏩ 5초"
                android:textColor="@color/on_surface"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 🔁 전체반복 -->
            <Button
                android:id="@+id/btnModeRepeatAll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:backgroundTint="@color/surface_variant"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="🔁 전체"
                android:textColor="@color/on_surface_secondary"
                android:textSize="10sp" />

            <!-- 🔂 1곡반복 -->
            <Button
                android:id="@+id/btnModeRepeatOne"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:backgroundTint="@color/surface_variant"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="🔂 1곡"
                android:textColor="@color/on_surface_secondary"
                android:textSize="10sp" />

            <!-- 🔀 랜덤반복 -->
            <Button
                android:id="@+id/btnModeShuffle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:backgroundTint="@color/surface_variant"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="🔀 랜덤"
                android:textColor="@color/on_surface_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. 플레이어 하단 3dp 회색 구분바 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider_gray" />

    <!-- 7. 하단 목록 일반 헤더 -->
    <LinearLayout
        android:id="@+id/layoutNormalHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📂 내 추출 음악 (Music/영상MP3)"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- [선택] 다중 선택 모드 진입 버튼 (회색) -->
        <TextView
            android:id="@+id/btnEnterSelectMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="선택"
            android:textColor="@color/on_surface_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 7-1. 하단 목록 선택 모드 헤더 (전체선택 | 선택개수 | 삭제 | 재생목록 추가 | 취소) -->
    <LinearLayout
        android:id="@+id/layoutSelectionHeader"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/cbSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/secondary"
            android:scaleX="0.85"
            android:scaleY="0.85"
            android:text="전체선택"
            android:textColor="@color/on_surface"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0개"
            android:textColor="@color/secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 삭제 버튼 (빨간색) -->
        <Button
            android:id="@+id/btnDeleteSelected"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:backgroundTint="@color/delete_red"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="삭제"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 재생목록 추가 버튼 -->
        <Button
            android:id="@+id/btnAddToPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="재생목록 추가"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 취소 버튼 -->
        <TextView
            android:id="@+id/btnCancelSelection"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="취소"
            android:textColor="@color/on_surface_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 8. 당겨서 새로고침(SwipeRefreshLayout) + 한 줄 리스트 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMp3List"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Music/영상MP3 폴더에 추출된 곡이 없습니다.\n상단에서 유튜브 링크나 영상 파일을 추출해 보세요! 🎵"
                android:textColor="@color/on_surface_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
